<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- The sandbox blocks Apple Events unless this is granted. TuckBar sends
         them to System Events to toggle the global menu-bar auto-hide and the
         Dock. The user still approves Automation at first use. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
